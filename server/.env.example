BACKEND_PORT=3001
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-secret-key-here

# Production note: use the Supabase project URL and server-only secret from the
# deployment secret store. Do not commit real credentials.

# Group Sync demo population is opt-in for local/non-production use only.
# The route remains disabled whenever NODE_ENV=production.
GROUP_SYNC_ENABLE_DEMO_POPULATE=false

# Email Configuration
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM_ADDRESS=noreply@booking.example.com

# Logging
LOG_LEVEL=debug
