# Browser authentication: use the same Supabase project as the existing AFDA apps.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Canonical Express API. Local default is http://localhost:3001.
NEXT_PUBLIC_CONTINUUM_API_URL=http://localhost:3001

# Existing independently deployed applications.
NEXT_PUBLIC_GROUPS_URL=http://localhost:3002
NEXT_PUBLIC_SCHEDULE_STAFF_URL=http://localhost:3003
NEXT_PUBLIC_SCHEDULE_STUDENT_URL=http://localhost:3000
NEXT_PUBLIC_WORKSUITE_URL=http://localhost:3004
